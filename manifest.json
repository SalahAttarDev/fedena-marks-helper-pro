{
  "manifest_version": 3,
  "name": "Marks Helper Pro",
  "version": "1.0.0",
  "description": "Check and fill Fedena Gradebook marks from your CA tracker (xlsx, CSV or JSON), then verify what was saved. Never submits on its own.",
  "permissions": ["storage", "activeTab"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Marks Helper Pro",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://*.fedena.com/assessments/attribute_scores*"],
      "js": ["lib/xlsx.full.min.js", "core.js", "ui.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon-32.png"], "matches": ["https://*.fedena.com/*"] }
  ],
  "browser_specific_settings": { "gecko": { "id": "marks-helper-pro@salahattar", "strict_min_version": "109.0" } }
}
